# Password required to log into /studio. Copy this file to .env.local and set your own.
STUDIO_PASSWORD=change-me

# Supabase project (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is a secret with full DB/storage access - server-only,
# never prefix it with NEXT_PUBLIC_ or reference it from client components.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
